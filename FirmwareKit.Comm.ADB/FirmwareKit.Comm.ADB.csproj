<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Maintained targets: current LTS (net10.0), previous LTS (net8.0), and
         netstandard2.0 for .NET Framework consumers. AOT publish narrows to
         net8.0/net10.0. -->
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(PublishAot)' == 'true'">net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>ZZi_Cai</Authors>
    <Title>FirmwareKit.Comm.ADB</Title>
    <Description>A high-performance .NET implementation of the Android Debug Bridge (ADB) protocol over USB and TCP, strictly aligned with AOSP logic. Part of the FirmwareKit ecosystem: direct-write to adbd (no client/server split), with shell v2, sync (file transfer), reverse, mDNS discovery, and an adb-compatible CLI.</Description>
    <PackageProjectUrl>https://github.com/Uotan-Dev/FirmwareKit.Comm.ADB</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Uotan-Dev/FirmwareKit.Comm.ADB</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>adb;android;firmware;debug;usb;shell;sync;mdns</PackageTags>
    <Copyright>Copyright (c) 2026 ZZi_Cai</Copyright>
    <Version>1.0.0</Version>
    <PackageId>FirmwareKit.Comm.ADB</PackageId>
    <Product>FirmwareKit.Comm.ADB</Product>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Local dev override: reference the locally-fixed FirmwareKit.Comm source so
      the macOS native (IOKit) backend fixes are exercised by the CLI, instead of
      the published 1.2.0 package whose IOUSBHost backend is unloadable on current
      macOS. Restore to a PackageReference for release builds.
      <para>本地开发覆盖：引用本地修复后的 FirmwareKit.Comm 源码，使 CLI 使用已修复的
      macOS native（IOKit）后端，而非发布版 1.2.0 包（其 IOUSBHost 后端在当前 macOS
      上不可加载）。发布构建时恢复为 PackageReference。</para>
    -->
    <ProjectReference Include="..\..\firmwarekit.comm\FirmwareKit.Comm\FirmwareKit.Comm.csproj" />
    <PackageReference Include="Makaretu.Dns.Multicast" Version="0.27.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FirmwareKit.Comm.ADB.Tests" />
  </ItemGroup>

</Project>
